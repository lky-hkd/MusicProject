# =====================================================================
# 生产环境变量模板
# 复制为 .env（或直接 export）并填入真实值后启动
# ---------------------------------------------------------------------
# 切勿把真实 .env 提交到 git
# =====================================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- 数据库 ---
DB_URL=jdbc:mysql://mysql:3306/music_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=music
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_MAX=20
DB_POOL_MIN=5

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_DATABASE=0

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=music
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_VHOST=/

# --- LLM（智谱 GLM）---
LLM_API_KEY=CHANGE_ME
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_MODEL_ID=glm-4-flash

# --- CORS 白名单（生产真实域名，逗号分隔）---
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- 支付宝（正式环境）---
ALIPAY_APP_ID=CHANGE_ME
ALIPAY_PRIVATE_KEY=CHANGE_ME
ALIPAY_PUBLIC_KEY=CHANGE_ME
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/order/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/#/order-pay

# --- 上传目录（容器内持久卷）---
UPLOAD_DIR=/data/uploads